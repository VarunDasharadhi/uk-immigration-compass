# Copy this file to .env.local and fill in your actual keys.
# DO NOT commit .env.local to version control.

# ── OpenRouter (required for live AI calls) ──────────────────────────────────
# Get a free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (default: google/gemini-2.5-flash)
# Data features use this model with :online suffix for web search.
# Simplify uses the base model (no web search needed).
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 10000)
PORT=10000
NODE_ENV=development

# ── Frontend API base URL ────────────────────────────────────────────────────
# Only needed in development if the Vite dev server (port 3000) talks to
# the API server on a different port. Leave unset when running from server.js.
# VITE_API_URL=http://localhost:10000

# ── Companies House (optional) ───────────────────────────────────────────────
# Enables real "nature of business" data and a confirmed Companies House
# profile link on the Sponsor Checker. Get a free key at
# https://developer.company-information.service.gov.uk/
# Without this set, the Sponsor Checker's "Find out more" links still work
# (search links only) — Companies House data is just skipped.
# COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# ── Email alerts (optional) ──────────────────────────────────────────────────
# Enables the double opt-in alert signup and the daily digest. Storage uses
# the same Upstash Redis as the feed cache (no extra vars). Without these,
# the signup endpoint reports "not available" and the digest is skipped.
# Request a key at https://resend.com
# RESEND_API_KEY=your_resend_api_key_here
# Verified sending address, e.g. "UK Immigration Compass <alerts@yourdomain>".
# Unset it falls back to Resend's sandbox sender, which only reaches the
# account owner's own inbox.
# ALERTS_FROM_EMAIL="UK Immigration Compass <alerts@yourdomain>"
